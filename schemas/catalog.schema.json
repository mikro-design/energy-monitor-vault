{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Energy Monitor catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "vendor",
    "name",
    "category",
    "aliases",
    "description",
    "sources",
    "pins",
    "radio",
    "simulation"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
    },
    "vendor": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "wireless_soc",
        "mcu",
        "buck",
        "buck_boost",
        "boost",
        "ldo",
        "charger",
        "harvester_pmic",
        "solar_cell",
        "pmic"
      ]
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "url", "kind", "reviewed_on", "access"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://[^ /]+/"
          },
          "kind": {
            "enum": ["product_page", "datasheet", "application_note"]
          },
          "reviewed_on": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "access": {
            "enum": ["reviewed", "search_excerpt"]
          }
        }
      }
    },
    "pins": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "package", "entries", "notes"],
      "properties": {
        "status": {
          "enum": ["partial", "not_characterized"]
        },
        "package": {
          "type": ["string", "null"]
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "direction",
              "role",
              "package_pins",
              "source",
              "note"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "direction": {
                "enum": ["input", "output", "bidirectional", "passive"]
              },
              "role": {
                "enum": [
                  "power",
                  "return",
                  "sense",
                  "switch_node",
                  "control",
                  "signal",
                  "storage"
                ]
              },
              "package_pins": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "source": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "radio": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocols",
            "phys",
            "operating_points",
            "timing_status",
            "notes"
          ],
          "properties": {
            "protocols": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": ["ble", "ieee802154"]
              }
            },
            "phys": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "protocol", "bitrate_bps", "source"],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]+$"
                  },
                  "protocol": {
                    "enum": ["ble", "ieee802154"]
                  },
                  "bitrate_bps": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "source": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]+$"
                  }
                }
              }
            },
            "operating_points": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "mode",
                  "phy",
                  "tx_power_dbm",
                  "current_a",
                  "current_scope",
                  "conditions",
                  "source"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]+$"
                  },
                  "mode": {
                    "enum": ["tx", "rx", "sleep", "cpu"]
                  },
                  "phy": {
                    "type": ["string", "null"]
                  },
                  "tx_power_dbm": {
                    "type": ["number", "null"]
                  },
                  "current_a": {
                    "type": "number",
                    "minimum": 0
                  },
                  "current_scope": {
                    "enum": ["whole_device", "radio_only", "unspecified"]
                  },
                  "conditions": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]+$"
                  }
                }
              }
            },
            "timing_status": {
              "const": "not_characterized"
            },
            "notes": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "model_file", "scope", "blockers"],
      "properties": {
        "status": {
          "enum": ["catalog_only", "runnable_approximation"]
        },
        "model_file": {
          "enum": [null, "part.json"]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
