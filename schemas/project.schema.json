{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project",
  "type": "object",
  "properties": {
    "duration_s": {
      "type": "number",
      "format": "double"
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Edge"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Event"
      }
    },
    "lock": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Pin"
      }
    },
    "name": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Node"
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Part"
      }
    },
    "revision": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "scenario": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "revision",
    "scenario",
    "duration_s",
    "parts",
    "lock",
    "nodes",
    "edges",
    "events"
  ],
  "$defs": {
    "ConverterOutput": {
      "type": "object",
      "properties": {
        "efficiency": {
          "type": "number",
          "format": "double"
        },
        "enabled": {
          "type": "boolean"
        },
        "max_current_a": {
          "type": "number",
          "format": "double"
        },
        "voltage_v": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "voltage_v",
        "efficiency",
        "max_current_a",
        "enabled"
      ]
    },
    "Edge": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/Endpoint"
        },
        "id": {
          "type": "string"
        },
        "to": {
          "$ref": "#/$defs/Endpoint"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to"
      ]
    },
    "Endpoint": {
      "type": "object",
      "properties": {
        "node": {
          "type": "string"
        },
        "port": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "node",
        "port"
      ]
    },
    "Event": {
      "type": "object",
      "properties": {
        "duration_s": {
          "type": "number",
          "format": "double"
        },
        "enabled": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "node_id": {
          "type": "string"
        },
        "period_s": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "start_s": {
          "type": "number",
          "format": "double"
        },
        "state": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "node_id",
        "state",
        "start_s",
        "duration_s",
        "enabled"
      ]
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "class": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "class",
        "note"
      ]
    },
    "Model": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "capacity_ah": {
              "type": "number",
              "format": "double"
            },
            "initial_soc": {
              "type": "number",
              "format": "double"
            },
            "kind": {
              "type": "string",
              "const": "battery"
            },
            "max_current_a": {
              "type": "number",
              "format": "double"
            },
            "voltage_v": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "voltage_v",
            "capacity_ah",
            "initial_soc",
            "max_current_a"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "supply"
            },
            "max_current_a": {
              "type": "number",
              "format": "double"
            },
            "voltage_v": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "voltage_v",
            "max_current_a"
          ]
        },
        {
          "type": "object",
          "properties": {
            "iq_a": {
              "type": "number",
              "format": "double"
            },
            "kind": {
              "type": "string",
              "const": "converter"
            },
            "min_input_v": {
              "type": "number",
              "format": "double"
            },
            "outputs": {
              "description": "Electrical behavior keyed by the stable output port ID.",
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/ConverterOutput"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "iq_a",
            "min_input_v",
            "outputs"
          ]
        },
        {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "kind": {
              "type": "string",
              "const": "switch"
            },
            "leakage_a": {
              "type": "number",
              "format": "double"
            },
            "resistance_ohm": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "enabled",
            "resistance_ohm",
            "leakage_a"
          ]
        },
        {
          "type": "object",
          "properties": {
            "default_state": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "load"
            },
            "min_voltage_v": {
              "type": "number",
              "format": "double"
            },
            "states": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "format": "double"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "states",
            "default_state",
            "min_voltage_v"
          ]
        }
      ]
    },
    "Node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "part_id": {
          "type": "string"
        },
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "part_id",
        "x",
        "y"
      ]
    },
    "Part": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/Model"
        },
        "name": {
          "type": "string"
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Port"
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "revision": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "name",
        "revision",
        "license",
        "ports",
        "model",
        "provenance"
      ]
    },
    "Pin": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "revision",
        "sha256"
      ]
    },
    "Port": {
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable connection identity, independent of the displayed vendor name.",
          "type": "string"
        },
        "name": {
          "description": "Exact vendor spelling and case, e.g. VOUT_S1 or VDD_nRF.",
          "type": "string"
        },
        "package_pins": {
          "description": "Physical package pin numbers/names. Empty when unspecified.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "type": {
          "$ref": "#/$defs/PortType"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "package_pins"
      ]
    },
    "PortType": {
      "type": "string",
      "enum": [
        "power_in",
        "power_out"
      ]
    }
  }
}
