{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Part",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "model": {
      "$ref": "#/$defs/Model"
    },
    "name": {
      "type": "string"
    },
    "ports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Port"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Evidence"
      }
    },
    "revision": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "revision",
    "license",
    "ports",
    "model",
    "provenance"
  ],
  "$defs": {
    "ConverterOutput": {
      "type": "object",
      "properties": {
        "efficiency": {
          "type": "number",
          "format": "double"
        },
        "enabled": {
          "type": "boolean"
        },
        "max_current_a": {
          "type": "number",
          "format": "double"
        },
        "voltage_v": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "voltage_v",
        "efficiency",
        "max_current_a",
        "enabled"
      ]
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "class": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "class",
        "note"
      ]
    },
    "Harvester": {
      "type": "object",
      "properties": {
        "charge_stop_v": {
          "type": "number",
          "format": "double"
        },
        "efficiency": {
          "type": "number",
          "format": "double"
        },
        "max_storage_v": {
          "type": "number",
          "format": "double"
        },
        "min_storage_v": {
          "type": "number",
          "format": "double"
        },
        "off_power_w": {
          "description": "Explicit estimate while waiting to restart, excluding storage leakage.",
          "type": "number",
          "format": "double"
        },
        "restart_v": {
          "type": "number",
          "format": "double"
        },
        "storage_port": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "storage_port",
        "efficiency",
        "min_storage_v",
        "max_storage_v",
        "charge_stop_v",
        "restart_v",
        "off_power_w"
      ]
    },
    "LoadOperation": {
      "type": "object",
      "properties": {
        "duration_s": {
          "type": "number",
          "format": "double"
        },
        "energy_j": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "energy_j",
        "duration_s"
      ]
    },
    "LoadStateUnit": {
      "type": "string",
      "enum": [
        "A",
        "W"
      ]
    },
    "Model": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "capacity_ah": {
              "type": "number",
              "format": "double"
            },
            "initial_soc": {
              "type": "number",
              "format": "double"
            },
            "kind": {
              "type": "string",
              "const": "battery"
            },
            "max_current_a": {
              "type": "number",
              "format": "double"
            },
            "voltage_v": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "voltage_v",
            "capacity_ah",
            "initial_soc",
            "max_current_a"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "supply"
            },
            "max_current_a": {
              "type": "number",
              "format": "double"
            },
            "voltage_v": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "voltage_v",
            "max_current_a"
          ]
        },
        {
          "type": "object",
          "properties": {
            "area_m2": {
              "type": "number",
              "format": "double"
            },
            "curve": {
              "description": "Ordered manufacturer MPP samples; linear interpolation within the table only.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/SolarPoint"
              }
            },
            "default_state": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "solar"
            },
            "states_lux": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "format": "double"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "area_m2",
            "states_lux",
            "default_state",
            "curve"
          ]
        },
        {
          "type": "object",
          "properties": {
            "iq_a": {
              "type": "number",
              "format": "double"
            },
            "kind": {
              "type": "string",
              "const": "converter"
            },
            "min_input_v": {
              "type": "number",
              "format": "double"
            },
            "outputs": {
              "description": "Electrical behavior keyed by the stable output port ID.",
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/ConverterOutput"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "iq_a",
            "min_input_v",
            "outputs"
          ]
        },
        {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "kind": {
              "type": "string",
              "const": "switch"
            },
            "leakage_a": {
              "type": "number",
              "format": "double"
            },
            "resistance_ohm": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "enabled",
            "resistance_ohm",
            "leakage_a"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "storage"
            },
            "leakage_w": {
              "type": "number",
              "format": "double"
            },
            "store": {
              "$ref": "#/$defs/Storage"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "store",
            "leakage_w"
          ]
        },
        {
          "type": "object",
          "properties": {
            "default_state": {
              "type": "string"
            },
            "harvester": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Harvester"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "const": "load"
            },
            "min_voltage_v": {
              "type": "number",
              "format": "double"
            },
            "operations": {
              "description": "Energy per scheduled operation, spread over the event's duration.",
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/LoadOperation"
              }
            },
            "state_unit": {
              "description": "New models use W. Omission preserves legacy constant-current states and hashes.",
              "$ref": "#/$defs/LoadStateUnit"
            },
            "states": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "format": "double"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "states",
            "default_state",
            "min_voltage_v"
          ]
        }
      ]
    },
    "Port": {
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable connection identity, independent of the displayed vendor name.",
          "type": "string"
        },
        "name": {
          "description": "Exact vendor spelling and case, e.g. VOUT_S1 or VDD_nRF.",
          "type": "string"
        },
        "package_pins": {
          "description": "Physical package pin numbers/names. Empty when unspecified.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "type": {
          "$ref": "#/$defs/PortType"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "package_pins"
      ]
    },
    "PortType": {
      "type": "string",
      "enum": [
        "power_in",
        "power_out",
        "power_storage"
      ]
    },
    "SolarPoint": {
      "type": "object",
      "properties": {
        "illuminance_lux": {
          "type": "number",
          "format": "double"
        },
        "power_density_w_m2": {
          "type": "number",
          "format": "double"
        },
        "voltage_v": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "illuminance_lux",
        "power_density_w_m2",
        "voltage_v"
      ]
    },
    "Storage": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "capacitance_f": {
              "type": "number",
              "format": "double"
            },
            "initial_voltage_v": {
              "type": "number",
              "format": "double"
            },
            "rated_voltage_v": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "capacitor"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "capacitance_f",
            "initial_voltage_v",
            "rated_voltage_v"
          ]
        },
        {
          "type": "object",
          "properties": {
            "capacitance_f": {
              "type": "number",
              "format": "double"
            },
            "initial_voltage_v": {
              "type": "number",
              "format": "double"
            },
            "rated_voltage_v": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "supercapacitor"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "capacitance_f",
            "initial_voltage_v",
            "rated_voltage_v"
          ]
        },
        {
          "description": "Linear open-circuit voltage versus charge, without ESR or rate effects.",
          "type": "object",
          "properties": {
            "capacity_ah": {
              "type": "number",
              "format": "double"
            },
            "empty_voltage_v": {
              "type": "number",
              "format": "double"
            },
            "full_voltage_v": {
              "type": "number",
              "format": "double"
            },
            "initial_soc": {
              "type": "number",
              "format": "double"
            },
            "rechargeable": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "battery"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "capacity_ah",
            "empty_voltage_v",
            "full_voltage_v",
            "initial_soc",
            "rechargeable"
          ]
        }
      ]
    }
  }
}
